# Caddyfile para o OperaBeauty

{$DOMAIN::80} {
    # Compressão gzip/zstd para otimizar tráfego
    encode zstd gzip

    # Cabeçalhos de segurança universais (Security Headers)
    header {
        # HSTS (Strict-Transport-Security) - Força HTTPS por 1 ano com subdomínios e preload
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Previne MIME-type sniffing
        X-Content-Type-Options "nosniff"

        # Proteção contra clickjacking
        X-Frame-Options "SAMEORIGIN"

        # Controle de Referrer para proteção de privacidade
        Referrer-Policy "strict-origin-when-cross-origin"

        # Restringe permissões de APIs de hardware e recursos sensíveis
        Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(self), usb=()"

        # Proteção XSS para navegadores legados
        X-XSS-Protection "1; mode=block"

        # Content Security Policy em modo relatório (não bloqueante)
        Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https: http:; connect-src 'self' ws: wss: https: http:; frame-ancestors 'self'; manifest-src 'self'; worker-src 'self' blob:;"

        # Remove assinatura e identificação tecnológica do servidor web
        -Server
        -X-Powered-By
    }

    # Proxy reverso para o backend DEVE vir primeiro e isolado
    handle /api/* {
        reverse_proxy api:5000
    }
    
    # Proxy para os arquivos de upload do backend
    handle /uploads/* {
        reverse_proxy api:5000
    }

    # Manifest dinâmico por tenant - proxy para API backend
    # Cada salão recebe um manifest com start_url e scope corretos
    # Isso resolve o problema do iOS sair do modo standalone
    handle /api/manifest/* {
        reverse_proxy api:5000
    }

    # BLOQUEIO: Impede o manifest.webmanifest estático de ser servido
    handle /manifest.webmanifest {
        respond 404
    }

    # Assets versionados com hash (Vite dist/assets/*) - Cache imutável longo (1 ano)
    handle /assets/* {
        root * /srv/dist
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Service Worker e scripts PWA - sem cache para garantir atualizações imediatas
    handle /sw.js {
        root * /srv/dist
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    handle /custom-sw.js {
        root * /srv/dist
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    # Detecção de robôs de redes sociais e crawlers de busca para SSR / Pré-renderização de SEO dinâmico (F3 / D20)
    # Permite que links compartilhados no WhatsApp, Facebook, Instagram, Twitter e Telegram mostrem a foto,
    # o nome real do salão e o título personalizado em vez das tags globais do SaaS.
    @social_crawlers {
        header_regexp User-Agent "(?i)(facebookexternalhit|whatsapp|twitterbot|telegrambot|linkedinbot|slackbot|applebot|discordbot|bingbot|googlebot)"
        not path /api/* /assets/* /uploads/* /sw.js /custom-sw.js /favicon.* /robots.txt /sitemap.xml
        not path_regexp static_files "\.(png|jpg|jpeg|gif|svg|webp|ico|css|js|woff|woff2|ttf|map)$"
    }
    handle @social_crawlers {
        rewrite * /api/seo/render{path}
        reverse_proxy api:5000
    }

    # Todo o resto vai pro Frontend (React SPA)
    handle {
        root * /srv/dist
        try_files {path} /index.html
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }
}

