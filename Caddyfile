# Caddyfile para o OperaBeauty

{$DOMAIN:localhost} {
    # Compressão gzip/zstd para otimizar tráfego
    encode zstd gzip

    # Proxy reverso para o backend DEVE vir primeiro e isolado
    handle /api/* {
        reverse_proxy api:5000
    }
    
    # Proxy para os arquivos de upload do backend
    handle /uploads/* {
        reverse_proxy api:5000
    }

    # Manifest dinâmico por tenant - proxy para API backend
    # Cada salão recebe um manifest com start_url e scope corretos
    # Isso resolve o problema do iOS sair do modo standalone
    handle /api/manifest/* {
        reverse_proxy api:5000
    }

    # BLOQUEIO: Impede o manifest.webmanifest estático de ser servido
    handle /manifest.webmanifest {
        respond 404
    }

    # Service Worker - sem cache para sempre pegar a versão mais recente
    handle /sw.js {
        root * /srv/dist
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    # Todo o resto vai pro Frontend (React)
    handle {
        root * /srv/dist
        try_files {path} /index.html
        file_server
    }
}

