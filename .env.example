# ==============================================================================
# OperaBeauty — Template Seguro de Variáveis de Ambiente (.env.example)
# FASE 43: C4 (P0) — Segredos e Ambiente
#
# INSTRUÇÕES DE SEGURANÇA EM PRODUÇÃO:
# 1. NUNCA comite arquivos .env no repositório Git!
# 2. Defina permissões estritas no servidor de produção:
#    chmod 600 .env
# 3. Utilize segredos criptograficamente fortes e diferentes entre ambientes
#    (Desenvolvimento, Homologação e Produção).
# 4. Gere chaves fortes com: node scripts/generate-secrets.js ou openssl rand -hex 32
# ==============================================================================

# Ambiente de Execução
NODE_ENV=production
PORT=5000

# Domínio e Infraestrutura (Caddy HTTPS automático)
DOMAIN=seudominio.com.br
ALLOWED_ORIGINS=https://seudominio.com.br,https://app.seudominio.com.br

# Banco de Dados PostgreSQL (Produção / Container operabeauty-db)
DB_USER=postgres
DB_PASSWORD=gerar_senha_ultra_forte_com_minimo_32_caracteres_aqui
DB_HOST=operabeauty-db
DB_PORT=5432
DB_NAME=operabeauty

# Cache e Filas (Redis)
REDIS_URL=redis://operabeauty-redis:6379

# Autenticação e Criptografia da Aplicação
# Gere com: openssl rand -hex 32
JWT_SECRET=gerar_jwt_secret_hex_64_chars_com_openssl_rand_hex_32
# Chave simétrica de 256 bits para criptografar credenciais de gateway no banco (AES-256-GCM)
ENCRYPTION_KEY=gerar_encryption_key_hex_64_chars_com_openssl_rand_hex_32

# Disaster Recovery & Backup Criptografado (scripts/backup.sh e scripts/restore.sh)
# Senha mestra OpenSSL AES-256-CBC PBKDF2 para os arquivos .dump.enc e .tar.gz.enc
BACKUP_ENCRYPTION_KEY=gerar_backup_passphrase_ultra_forte_aqui

# Notificações Web Push (VAPID)
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=sua_chave_publica_vapid_base64url_aqui
VAPID_PRIVATE_KEY=sua_chave_privada_vapid_base64url_aqui
VAPID_SUBJECT=mailto:suporte@seudominio.com.br

# Monitoramento e Alertas Proativos (Opcional - Notificações de Erro 500 e Status de Backup)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
TELEGRAM_WEBHOOK_URL=https://api.telegram.org/bot...
TELEGRAM_CHAT_ID=

# S3 / Cloudflare R2 / Backblaze B2 (Opcional - Sincronização Externa de Backups)
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
